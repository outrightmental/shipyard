{
  "name": "shipyard",
  "version": "1.0.0",
  "description": "Shipyard: a distributed agentic coding factory, centralized for the whole organization",
  "main": "dist/src/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run typecheck:dashboard && npm run build:dashboard",
    "typecheck:dashboard": "tsc -p src/dashboard/tsconfig.json",
    "build:dashboard": "esbuild src/dashboard/main.ts --bundle --format=esm --sourcemap --tsconfig=src/dashboard/tsconfig.json --outfile=dist/dashboard/bundle.js",
    "watch:dashboard": "esbuild src/dashboard/main.ts --bundle --format=esm --sourcemap --tsconfig=src/dashboard/tsconfig.json --outfile=dist/dashboard/bundle.js --watch",
    "predev": "npm run build:dashboard",
    "dev": "tsx src/index.ts",
    "predemo:dashboard": "npm run build:dashboard",
    "demo:dashboard": "tsx tools/dashboard-demo.ts",
    "start": "npm run build && node dist/src/index.js",
    "test": "node --import tsx --test --test-force-exit \"test/**/*.test.ts\"",
    "build:lambda": "node tools/build-lambda.mjs",
    "build:console": "node tools/build-console.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/outrightmental/shipyard.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "bugs": {
    "url": "https://github.com/outrightmental/shipyard/issues"
  },
  "homepage": "https://github.com/outrightmental/shipyard#readme",
  "devDependencies": {
    "@aws-sdk/client-apigatewaymanagementapi": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-ssm": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^25.6.2",
    "@types/ws": "^8.18.1",
    "esbuild": "^0.25.0",
    "lit": "^3.2.0",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "js-yaml": "^5.2.0",
    "open": "^10.1.0",
    "ws": "^8.17.0"
  },
  "private": true
}
